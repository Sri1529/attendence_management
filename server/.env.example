# ==============================================================
# Attendance & Salary SaaS — Backend Environment Configuration
# ==============================================================

# Application Environment & Server Port
NODE_ENV=production
PORT=4000

# PostgreSQL Database Connection
# Inside Docker network, host is 'postgres'
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=srihari
DATABASE_PASSWORD=your_secure_db_password
DATABASE_NAME=attendence_management
DATABASE_TEST_NAME=attendence_management_test

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_min32chars
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Payment Gateway (Optional for subscriptions)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR

# Cloudinary Storage (Optional for external assets)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
