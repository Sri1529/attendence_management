# ==============================================================================
# Attendance & Salary SaaS — Root Environment Configuration (.env)
# ==============================================================================
# Copy this file to `.env` before running `docker compose up -d`:
#   cp .env.example .env
#
# Update the passwords and secret keys with strong values before production use.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Inside Docker, the backend connects to the 'postgres' service container.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=srihari
DATABASE_PASSWORD=your_secure_db_password
DATABASE_NAME=attendence_management
DATABASE_TEST_NAME=attendence_management_test

# ------------------------------------------------------------------------------
# 2. Ports & Network Configuration
# ------------------------------------------------------------------------------
# Host-mapped port for the NestJS API backend
PORT=4000

# Host-mapped port for the Next.js frontend
FRONTEND_PORT=3000

# API URL accessed by client web browsers (points to host backend port)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 3. Security & Authentication (JWT Secrets)
# ------------------------------------------------------------------------------
# Generate strong, random secrets (at least 32 characters)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_min32chars
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Optional Integrations (Razorpay Payment Gateway)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR

# ------------------------------------------------------------------------------
# 5. Optional Integrations (Cloudinary Cloud Storage)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
